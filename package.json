{
  "name": "dsh-usage",
  "version": "1.5.3",
  "type": "module",
  "description": "Token usage, request counts and estimated cost for every DeepSeek Harness Session, with a sidebar page, a per-message cost chip and the account balance.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "usage",
    "cost",
    "tokens",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonMedy/dsh-usage.git"
  },
  "homepage": "https://github.com/SimonMedy/dsh-usage#readme",
  "bugs": {
    "url": "https://github.com/SimonMedy/dsh-usage/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {"test": "node --test" },"files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
